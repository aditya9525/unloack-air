{% comment %}
  UnlockedAir - "Why it works" Before/After Comparison Section
  Features:
  - Responsive percentage-based layout (no fixed widths)
  - Embedded CSS scoped to section ID
  - Interactive Before/After drag & touch image slider
  - Fully customizable Shopify Theme Customizer Schema
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .why-it-works-section {
    width: 100%;
    box-sizing: border-box;
    background-color: {{ section.settings.bg_color | default: '#F4F7F7' }};
    padding: 60px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
  }

  .why-it-works-container {
    width: 90%;
    max-width: 1312px;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  /* Heading */
  .why-it-works-heading {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .why-it-works-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    background-color: #DCEBEC;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    color: #070D10;
    white-space: nowrap;
  }

  .why-it-works-title {
    width: 100%;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-style: normal;
    font-weight: 800;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -0.015em;
    color: #070D10;
    margin: 0;
    text-align: center;
  }

  .why-it-works-subtitle {
    width: 100%;
    max-width: 860px;
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    color: #4A5C63;
    margin: 0;
    text-align: center;
  }

  /* Before / After Media Container */
  .why-it-works-media {
    width: 100%;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 1312 / 520;
    box-shadow: 0 8px 30px rgba(7, 13, 16, 0.06);
    user-select: none;
    touch-action: pan-y;
    background-color: #E2ECEE;
  }

  .why-it-works-media__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .why-it-works-media__after {
    z-index: 1;
  }

  .why-it-works-media__before {
    z-index: 2;
    clip-path: inset(0 calc(100% - var(--split-pos, 50%)) 0 0);
    will-change: clip-path;
  }

  /* Vertical Divider Line */
  .why-it-works-media__divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split-pos, 50%);
    width: 4px;
    background-color: #FFFFFF;
    transform: translateX(-50%);
    z-index: 3;
    pointer-events: none;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.25);
  }

  /* Center Slider Handle */
  .why-it-works-media__handle {
    position: absolute;
    top: 50%;
    left: var(--split-pos, 50%);
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    background-color: #FFFFFF;
    border-radius: 50%;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    pointer-events: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .why-it-works-media:active .why-it-works-media__handle,
  .why-it-works-media:focus-within .why-it-works-media__handle {
    transform: translate(-50%, -50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .why-it-works-media__handle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
  }

  /* Badges */
  .why-it-works-media__badge {
    position: absolute;
    bottom: 24px;
    background: rgba(0, 0, 0, 0.9);
    color: #FFFFFF;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    padding: 10px 18px;
    border-radius: 12px;
    z-index: 5;
    pointer-events: none;
    letter-spacing: -0.01em;
    backdrop-filter: blur(8px);
  }

  .why-it-works-media__badge--left {
    left: 24px;
  }

  .why-it-works-media__badge--right {
    right: 24px;
  }

  /* Range input overlay for smooth interaction & accessibility */
  .why-it-works-media__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 6;
    margin: 0;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Compare Cards */
  .why-it-works-cards {
    width: 100%;
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: stretch;
    box-sizing: border-box;
  }

  .why-it-works-card {
    flex: 1 1 0%;
    width: 100%;
    box-sizing: border-box;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  /* Brand Card ("With UnlockedAir") */
  .why-it-works-card--brand {
    background-color: #0B3C44;
    border: 1px solid #C5D6D8;
  }

  /* Competitor Card ("Typical nasal strips") */
  .why-it-works-card--competitor {
    background-color: #FFFFFF;
    border: 1px solid transparent;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  .why-it-works-card__title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 30px;
    letter-spacing: -0.005em;
    margin: 0 0 2px 0;
  }

  .why-it-works-card--brand .why-it-works-card__title {
    color: #FFFFFF;
  }

  .why-it-works-card--competitor .why-it-works-card__title {
    color: #4A5C63;
  }

  .why-it-works-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .why-it-works-card__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .why-it-works-card__icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .why-it-works-card--brand .why-it-works-card__icon {
    background-color: #2EE6D6;
  }

  .why-it-works-card--competitor .why-it-works-card__icon {
    background-color: #DCEBEC;
  }

  .why-it-works-card__text {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    margin: 0;
  }

  .why-it-works-card--brand .why-it-works-card__text {
    color: #FFFFFF;
  }

  .why-it-works-card--competitor .why-it-works-card__text {
    color: #070D10;
  }

  /* Responsive Mobile Breakpoint (<= 768px) */
  @media screen and (max-width: 768px) {
    .why-it-works-section {
      padding: 56px 0;
    }

    .why-it-works-container {
      width: 90%;
      align-items: flex-start;
      gap: 28px;
    }

    .why-it-works-heading {
      align-items: flex-start;
      text-align: left;
      gap: 10px;
    }

    .why-it-works-title {
      font-size: 32px;
      line-height: 36px;
      letter-spacing: -0.01em;
      text-align: left;
    }

    .why-it-works-subtitle {
      font-size: 16px;
      line-height: 24px;
      text-align: left;
    }

    .why-it-works-media {
      aspect-ratio: 350 / 300;
    }

    .why-it-works-media__divider {
      width: 3px;
    }

    .why-it-works-media__handle {
      width: 28px;
      height: 28px;
    }

    .why-it-works-media__badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      line-height: 16px;
    }

    .why-it-works-media__badge--left {
      left: 12px;
      bottom: 12px;
    }

    .why-it-works-media__badge--right {
      right: 12px;
      bottom: 12px;
    }

    .why-it-works-cards {
      flex-direction: column;
      gap: 16px;
    }

    .why-it-works-card {
      padding: 20px;
    }

    .why-it-works-card--competitor .why-it-works-card__title {
      font-size: 20px;
      line-height: 26px;
    }
  }
</style>

<div class="why-it-works-section" id="WhyItWorks-section">
  <div class="why-it-works-container">
    
    <!-- Heading Block -->
    <div class="why-it-works-heading">
      {% if section.settings.tag != blank %}
        <div class="why-it-works-tag">
          {{ section.settings.tag }}
        </div>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="why-it-works-title">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="why-it-works-subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    <!-- Before/After Interactive Comparison Frame -->
    <div class="why-it-works-media" id="mediaSlider" style="--split-pos: {{ section.settings.default_slider_pos | default: 50 }}%;">
      
      <!-- After Image (Bottom Layer: With Unlocked Air) -->
      {% if section.settings.after_image != blank %}
        <img
          src="{{ section.settings.after_image | image_url: width: 1600 }}"
          alt="{{ section.settings.after_label | escape }}"
          class="why-it-works-media__img why-it-works-media__after"
          loading="lazy"
        >
      {% else %}
        <img
          src="{{ 'with-unlocked-air.jpg' | asset_url }}"
          alt="{{ section.settings.after_label | escape }}"
          class="why-it-works-media__img why-it-works-media__after"
          loading="lazy"
        >
      {% endif %}

      <!-- Before Image (Top Layer: Without Unlocked Air, clipped by slider position) -->
      {% if section.settings.before_image != blank %}
        <img
          src="{{ section.settings.before_image | image_url: width: 1600 }}"
          alt="{{ section.settings.before_label | escape }}"
          class="why-it-works-media__img why-it-works-media__before"
          loading="lazy"
        >
      {% else %}
        <img
          src="{{ 'without-unlocked-air.jpg' | asset_url }}"
          alt="{{ section.settings.before_label | escape }}"
          class="why-it-works-media__img why-it-works-media__before"
          loading="lazy"
        >
      {% endif %}

      <!-- Divider Line -->
      <div class="why-it-works-media__divider" aria-hidden="true"></div>

      <!-- Handle with Arrows -->
      <div class="why-it-works-media__handle" aria-hidden="true">
        <span class="why-it-works-media__handle-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.5 12.5L2 9L5.5 5.5" stroke="#000000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12.5 5.5L16 9L12.5 12.5" stroke="#000000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>

      <!-- Left Label Badge -->
      {% if section.settings.before_label != blank %}
        <div class="why-it-works-media__badge why-it-works-media__badge--left">
          {{ section.settings.before_label }}
        </div>
      {% endif %}

      <!-- Right Label Badge -->
      {% if section.settings.after_label != blank %}
        <div class="why-it-works-media__badge why-it-works-media__badge--right">
          {{ section.settings.after_label }}
        </div>
      {% endif %}

      <!-- Accessible Range Input -->
      <input
        type="range"
        min="0"
        max="100"
        value="{{ section.settings.default_slider_pos | default: 50 }}"
        class="why-it-works-media__range"
        aria-label="Drag to compare before and after"
      >
    </div>

    <!-- Comparison Cards -->
    <div class="why-it-works-cards">
      
      <!-- Card 1: With UnlockedAir -->
      <div class="why-it-works-card why-it-works-card--brand">
        {% if section.settings.card_1_title != blank %}
          <h3 class="why-it-works-card__title">
            {{ section.settings.card_1_title }}
          </h3>
        {% endif %}

        <ul class="why-it-works-card__list">
          {% if section.settings.card_1_item_1 != blank %}
            <li class="why-it-works-card__item">
              <span class="why-it-works-card__icon">
                <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 5L4.5 8.5L11 1.5" stroke="#070D10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="why-it-works-card__text">{{ section.settings.card_1_item_1 }}</span>
            </li>
          {% endif %}

          {% if section.settings.card_1_item_2 != blank %}
            <li class="why-it-works-card__item">
              <span class="why-it-works-card__icon">
                <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 5L4.5 8.5L11 1.5" stroke="#070D10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="why-it-works-card__text">{{ section.settings.card_1_item_2 }}</span>
            </li>
          {% endif %}

          {% if section.settings.card_1_item_3 != blank %}
            <li class="why-it-works-card__item">
              <span class="why-it-works-card__icon">
                <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 5L4.5 8.5L11 1.5" stroke="#070D10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="why-it-works-card__text">{{ section.settings.card_1_item_3 }}</span>
            </li>
          {% endif %}
        </ul>
      </div>

      <!-- Card 2: Typical nasal strips -->
      <div class="why-it-works-card why-it-works-card--competitor">
        {% if section.settings.card_2_title != blank %}
          <h3 class="why-it-works-card__title">
            {{ section.settings.card_2_title }}
          </h3>
        {% endif %}

        <ul class="why-it-works-card__list">
          {% if section.settings.card_2_item_1 != blank %}
            <li class="why-it-works-card__item">
              <span class="why-it-works-card__icon">
                <svg width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1H9" stroke="#070D10" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="why-it-works-card__text">{{ section.settings.card_2_item_1 }}</span>
            </li>
          {% endif %}

          {% if section.settings.card_2_item_2 != blank %}
            <li class="why-it-works-card__item">
              <span class="why-it-works-card__icon">
                <svg width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1H9" stroke="#070D10" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="why-it-works-card__text">{{ section.settings.card_2_item_2 }}</span>
            </li>
          {% endif %}

          {% if section.settings.card_2_item_3 != blank %}
            <li class="why-it-works-card__item">
              <span class="why-it-works-card__icon">
                <svg width="10" height="2" viewBox="0 0 10 2" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1H9" stroke="#070D10" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="why-it-works-card__text">{{ section.settings.card_2_item_3 }}</span>
            </li>
          {% endif %}
        </ul>
      </div>

    </div>

  </div>
</div>

<script>
  (function() {
    function initSlider() {
      const container = (document.getElementById('mediaSlider') || document.querySelector('.why-it-works-media'));
      if (!container) return;

      const rangeInput = container.querySelector('.why-it-works-media__range');
      if (!rangeInput) return;

      function updatePosition(val) {
        const clamped = Math.max(0, Math.min(100, val));
        container.style.setProperty('--split-pos', clamped + '%');
        rangeInput.value = clamped;
      }

      rangeInput.addEventListener('input', function(e) {
        updatePosition(e.target.value);
      });

      // Pointer drag support for fluid touch & mouse dragging
      let isDragging = false;

      function setFromPointer(e) {
        const rect = container.getBoundingClientRect();
        const clientX = e.clientX || (e.touches && e.touches[0] ? e.touches[0].clientX : null);
        if (clientX === null) return;
        const percent = ((clientX - rect.left) / rect.width) * 100;
        updatePosition(percent);
      }

      container.addEventListener('pointerdown', function(e) {
        isDragging = true;
        setFromPointer(e);
      });

      window.addEventListener('pointermove', function(e) {
        if (!isDragging) return;
        setFromPointer(e);
      });

      window.addEventListener('pointerup', function() {
        isDragging = false;
      });

      window.addEventListener('pointercancel', function() {
        isDragging = false;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSlider);
    } else {
      initSlider();
    }
  })();
</script>

{% schema %}
{
  "name": "Why It Works",
  "tag": "section",
  "class": "section-why-it-works",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F4F7F7"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag Label",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading Title",
      "default": "Wider lift that doesn’t fold."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "Strips pull from the bridge and can collapse when you inhale. UnlockedAir lifts from the sides with magnets, so your nostrils stay open."
    },
    {
      "type": "header",
      "content": "Image Comparison Slider"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image (Without Unlocked Air)"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image (With Unlocked Air)"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before Badge Label",
      "default": "without Unlocked Air"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After Badge Label",
      "default": "with Unlocked Air"
    },
    {
      "type": "range",
      "id": "default_slider_pos",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "label": "Default Divider Position",
      "default": 50
    },
    {
      "type": "header",
      "content": "Card 1: Brand Comparison"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Card 1 Title",
      "default": "With UnlockedAir"
    },
    {
      "type": "text",
      "id": "card_1_item_1",
      "label": "Card 1 Benefit 1",
      "default": "Lifts from the sides with magnets"
    },
    {
      "type": "text",
      "id": "card_1_item_2",
      "label": "Card 1 Benefit 2",
      "default": "Sweat-resistant hold for training"
    },
    {
      "type": "text",
      "id": "card_1_item_3",
      "label": "Card 1 Benefit 3",
      "default": "Reusable band, swap only the tabs"
    },
    {
      "type": "header",
      "content": "Card 2: Competitor Comparison"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Card 2 Title",
      "default": "Typical nasal strips"
    },
    {
      "type": "text",
      "id": "card_2_item_1",
      "label": "Card 2 Item 1",
      "default": "Pulls from the bridge and can collapse"
    },
    {
      "type": "text",
      "id": "card_2_item_2",
      "label": "Card 2 Item 2",
      "default": "Can peel off with sweat or oil"
    },
    {
      "type": "text",
      "id": "card_2_item_3",
      "label": "Card 2 Item 3",
      "default": "Thrown away after every use"
    }
  ],
  "presets": [
    {
      "name": "Why It Works"
    }
  ]
}
{% endschema %}
