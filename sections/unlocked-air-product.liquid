                    </div>
                    <div class="product-ugc-badge">
                      <span class="product-ugc-name">{{ block.settings.name | default: 'Verified Customer' }}</span>
                      {% if block.settings.role != blank %}
                        <span class="product-ugc-role">{{ block.settings.role }}</span>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            {% else %}
