<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 1. Initialize UGC Reviews Swiper Carousel
    var ugcSwiper = new Swiper('.product-ugc-swiper', {
      slidesPerView: 1.3,
      spaceBetween: 16,
      loop: true,
      navigation: {
        nextEl: '.product-ugc-next',
        prevEl: '.product-ugc-prev',
      },
      breakpoints: {
        480: {
          slidesPerView: 2,
          spaceBetween: 16,
        },
        768: {
          slidesPerView: 2.3,
          spaceBetween: 20,
        },
        1024: {
          slidesPerView: 2.5,
          spaceBetween: 22,
        }
      }
    });

    // 2. Initialize Thumbnails Swiper Carousel
    var thumbsSwiper = new Swiper('.product-thumbs-swiper', {
      slidesPerView: 6.5,
      spaceBetween: 8,
      freeMode: true,
      watchSlidesProgress: true,
      breakpoints: {
        320: {
          slidesPerView: 4.8,
          spaceBetween: 6,
        },
        480: {
          slidesPerView: 5.8,
          spaceBetween: 8,
        },
        768: {
          slidesPerView: 6.5,
          spaceBetween: 8,
        }
      },
      navigation: {
        nextEl: '.product-thumbs-next',
        prevEl: '.product-thumbs-prev',
      }
    });

    // 3. Initialize Main Product Swiper Gallery (Allows user to swipe main images)
    var productMainSwiper = new Swiper('.product-main-swiper', {
      slidesPerView: 1,
      spaceBetween: 0,
      speed: 350,
      grabCursor: true,
      autoHeight: false,
      resistanceRatio: 0.85
    });

    var thumbSlides = document.querySelectorAll('.product-thumb-slide');

    function syncActiveThumb(index) {
      thumbSlides.forEach(function (s, i) {
        if (i === index) {
          s.classList.add('is-active');
        } else {
          s.classList.remove('is-active');
        }
      });
      if (thumbsSwiper && typeof thumbsSwiper.slideTo === 'function') {
        thumbsSwiper.slideTo(index);
      }
    }

    // When main product image is swiped, update the active thumbnail
    if (productMainSwiper) {
      productMainSwiper.on('slideChange', function () {
        syncActiveThumb(productMainSwiper.activeIndex);
      });
    }

    // When a thumbnail is clicked, slide main swiper to that index
    thumbSlides.forEach(function (slide, idx) {
      slide.addEventListener('click', function () {
        if (productMainSwiper && typeof productMainSwiper.slideTo === 'function') {
          productMainSwiper.slideTo(idx);
        }
        syncActiveThumb(idx);
      });
    });

    // 3. Kit Quantity Selector Interaction & Dynamic Pricing
    var kitChips = document.querySelectorAll('.product-quantity-chip');
    var currentPriceEl = document.getElementById('displayCurrentPrice');
    var comparePriceEl = document.getElementById('displayComparePrice');
    var oneTimePriceEl = document.getElementById('offerOneTimePrice');
    var oneTimeCompareEl = document.getElementById('offerOneTimeCompare');
    var variantInput = document.getElementById('productVariantId');
    var quantityInput = document.getElementById('productQuantity');
    var sellingPlanInput = document.getElementById('productSellingPlan');

    // Appstle selling plan ID (if present on product)
    var defaultSellingPlanId = {{ first_selling_plan.id | default: '' | json }};

    // Base pricing dynamically read from Shopify Liquid
    var currencySymbol = {{ cart.currency.symbol | default: '$' | json }};
    var shopifyBasePrice = {{ raw_price | divided_by: 100.0 | json }};
    var shopifyComparePrice = {{ raw_compare | divided_by: 100.0 | json }};
    if (!shopifyBasePrice || shopifyBasePrice <= 0) shopifyBasePrice = 60.00;
    if (!shopifyComparePrice || shopifyComparePrice <= 0) shopifyComparePrice = shopifyBasePrice;

    var currentUnitBase = shopifyBasePrice;
    var currentUnitCompare = shopifyComparePrice;

    kitChips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        kitChips.forEach(function (c) { c.classList.remove('is-selected'); });
        chip.classList.add('is-selected');

        var kitNum = chip.getAttribute('data-kit');
        var variantId = chip.getAttribute('data-variant-id');
        var chipPrice = parseFloat(chip.getAttribute('data-price'));
        var chipCompare = parseFloat(chip.getAttribute('data-compare'));

        if (variantId && variantInput) {
          variantInput.value = variantId;
        }
        if (quantityInput) {
          quantityInput.value = kitNum;
        }

        if (!isNaN(chipPrice) && chipPrice > 0) {
          currentUnitBase = chipPrice;
        } else {
          currentUnitBase = shopifyBasePrice;
        }

        if (!isNaN(chipCompare) && chipCompare > 0) {
          currentUnitCompare = chipCompare;
        } else {
          currentUnitCompare = shopifyComparePrice;
        }

        var activeOffer = document.querySelector('.product-offer-card.is-selected');
        var offerType = activeOffer ? activeOffer.getAttribute('data-offer') : 'trial';

        updatePricing(offerType, kitNum);
      });
    });

    // 4. Offer Toggle Interaction (Free Trial / Appstle Subscription vs One-Time)
    var offerCards = document.querySelectorAll('.product-offer-card');
    var ctaLabel = document.getElementById('productCtaLabel');
    var priceTag = document.getElementById('displayPriceTag');

    offerCards.forEach(function (card) {
      card.addEventListener('click', function () {
        offerCards.forEach(function (c) { c.classList.remove('is-selected'); });
        card.classList.add('is-selected');

        var offerType = card.getAttribute('data-offer');
        var selectedChip = document.querySelector('.product-quantity-chip.is-selected');
        var kitNum = selectedChip ? selectedChip.getAttribute('data-kit') : '1';

        updatePricing(offerType, kitNum);
      });
    });

    function updatePricing(offerType, kitNum) {
      var k = parseInt(kitNum, 10) || 1;
      var trialLabel = {{ section.settings.trial_cta_label | default: 'Start my free trial' | json }};
      var onetimePrefix = {{ section.settings.onetime_cta_label | default: 'Buy now' | json }};

      if (offerType === 'trial') {
        if (sellingPlanInput) {
          sellingPlanInput.value = defaultSellingPlanId || '';
          sellingPlanInput.disabled = false;
        }

        // Synchronize with Appstle widget if present on page
        var appstleSubRadio = document.querySelector('.appstle_subscribe_save_radio, [name="appstle_selling_plan_option"][value="sub_save"], [name="appstle_selling_plan_option"][value="subscription"], input[value="sub_save"]');
        if (appstleSubRadio && !appstleSubRadio.checked) {
          appstleSubRadio.checked = true;
          appstleSubRadio.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (currentPriceEl) currentPriceEl.textContent = currencySymbol + '0.00';
        if (comparePriceEl) comparePriceEl.textContent = currencySymbol + (k * currentUnitCompare).toFixed(2);
        if (priceTag) {
          priceTag.textContent = {{ section.settings.trial_price_tag | default: 'Free trial' | json }};
          priceTag.style.display = 'inline-flex';
        }
        if (ctaLabel) ctaLabel.textContent = trialLabel;
      } else {
        if (sellingPlanInput) {
          sellingPlanInput.value = '';
          sellingPlanInput.disabled = true;
        }

        // Synchronize with Appstle widget if present on page
        var appstleOneTimeRadio = document.querySelector('.appstle_one_time_radio, [name="appstle_selling_plan_option"][value="one_time"], [name="appstle_selling_plan_option"][value="onetime"], input[value="one_time"]');
        if (appstleOneTimeRadio && !appstleOneTimeRadio.checked) {
          appstleOneTimeRadio.checked = true;
          appstleOneTimeRadio.dispatchEvent(new Event('change', { bubbles: true }));
        }

        var discount = k === 2 ? 0.8 : (k === 3 ? 0.7 : 1.0);
        var finalPrice = (currentUnitBase * k * discount).toFixed(2);
        var compPrice = (currentUnitCompare * k).toFixed(2);

        if (currentPriceEl) currentPriceEl.textContent = currencySymbol + finalPrice;
        if (comparePriceEl) comparePriceEl.textContent = currencySymbol + compPrice;
        if (oneTimePriceEl) oneTimePriceEl.textContent = currencySymbol + finalPrice;
        if (oneTimeCompareEl) oneTimeCompareEl.textContent = currencySymbol + compPrice;

        if (priceTag) {
          priceTag.textContent = k > 1 ? 'Save ' + ((1 - discount) * 100).toFixed(0) + '%' : 'One-time';
          priceTag.style.display = 'inline-flex';
        }
        if (ctaLabel) ctaLabel.textContent = onetimePrefix + ' · ' + currencySymbol + finalPrice;
      }
    }

    // Two-way sync: Listen to changes on external Appstle selling plan inputs if present
    document.addEventListener('change', function (e) {
      if (e.target && e.target.name === 'selling_plan' && e.target !== sellingPlanInput) {
        if (sellingPlanInput) {
          sellingPlanInput.value = e.target.value;
          if (e.target.value) {
            var trialCard = document.getElementById('offerFreeTrial');
            if (trialCard && !trialCard.classList.contains('is-selected')) {
              trialCard.click();
            }
          }
        }
      }
    });

    // 5. Accordion Toggle Interaction (Single-open: only one open at a time)
    var accordionHeaders = document.querySelectorAll('.product-accordion-header');
    accordionHeaders.forEach(function (header) {
      header.addEventListener('click', function () {
        var item = header.closest('.product-accordion-item');
        if (!item) return;

        var container = item.closest('.product-accordions') || document;
        var isOpen = item.classList.contains('is-open');

        // Close all items in this accordion list first
        var allItems = container.querySelectorAll('.product-accordion-item');
        allItems.forEach(function (otherItem) {
          otherItem.classList.remove('is-open');
          var otherHeader = otherItem.querySelector('.product-accordion-header');
          if (otherHeader) otherHeader.setAttribute('aria-expanded', 'false');
          var otherToggle = otherItem.querySelector('.product-accordion-toggle');
          if (otherToggle) otherToggle.textContent = '+';
        });

        // If the clicked item was not open, open it now
        if (!isOpen) {
          item.classList.add('is-open');
          header.setAttribute('aria-expanded', 'true');
          var toggle = header.querySelector('.product-accordion-toggle');
          if (toggle) toggle.textContent = '—';
        }
      });
    });

    // 6. Inline Video Playback for UGC Carousel Cards (Plays in place, no modal)
    var ugcSwiperContainer = document.querySelector('.product-ugc-swiper');
    if (ugcSwiperContainer) {
      ugcSwiperContainer.addEventListener('click', function (e) {
        var slide = e.target.closest('.product-ugc-slide');
        if (!slide) return;

        var video = slide.querySelector('.product-ugc-video');
        if (!video) return;

        var isPlaying = !video.paused && !video.ended;

        // Pause all other videos in the carousel
        var allVideos = ugcSwiperContainer.querySelectorAll('.product-ugc-video');
        allVideos.forEach(function (otherVid) {
          if (otherVid !== video) {
            otherVid.pause();
            var otherSlide = otherVid.closest('.product-ugc-slide');
            if (otherSlide) {
              otherSlide.classList.remove('is-playing');
            }
          }
        });

        if (isPlaying) {
          video.pause();
          slide.classList.remove('is-playing');
        } else {
          slide.classList.add('is-playing');
          var playPromise = video.play();
          if (playPromise !== undefined) {
            playPromise.catch(function () {
              // If unmuted playback is restricted, play muted
              video.muted = true;
              video.play().catch(function (err) {
                console.warn('Playback error:', err);
              });
            });
          }
        }
      });

      // Reset slide state and bring poster back when video ends or is paused
      var allUgcVideos = ugcSwiperContainer.querySelectorAll('.product-ugc-video');
      allUgcVideos.forEach(function (vid) {
        vid.addEventListener('ended', function () {
          var s = vid.closest('.product-ugc-slide');
          if (s) s.classList.remove('is-playing');
        });
        vid.addEventListener('pause', function () {
          var s = vid.closest('.product-ugc-slide');
          if (s) s.classList.remove('is-playing');
        });
      });

      // Pause playback when carousel slide changes
      if (ugcSwiper && typeof ugcSwiper.on === 'function') {
        ugcSwiper.on('slideChange', function () {
          var allVideos = ugcSwiperContainer.querySelectorAll('.product-ugc-video');
          allVideos.forEach(function (vid) {
            if (!vid.paused) {
              vid.pause();
              var s = vid.closest('.product-ugc-slide');
              if (s) s.classList.remove('is-playing');
            }
          });
        });
      }
    }
  });
</script>

