{% comment %}
  UnlockedAir - "Use Cases" Section
  Features:
  - Responsive percentage-based layout (no fixed widths)
  - Embedded CSS with clean direct class selectors (no section.id in CSS)
  - No clamp() and no mixed heights
  - Clean light background (#F4F7F7)
  - Desktop 4-column cards grid, mobile smooth swipeable carousel
  - Fully customizable Shopify Theme Customizer Schema
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .use-cases-section {
    width: 100%;
    box-sizing: border-box;
    position: relative;
    background-color: #F4F7F7;
    padding: 96px 0;
  }

  .use-cases-container {
    width: 90%;
    max-width: 1312px;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  /* Heading Block */
  .use-cases-heading {
    width: 100%;
    max-width: 900px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .use-cases-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    background-color: #DCEBEC;
    border-radius: 999px;
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    color: #070D10;
  }

  .use-cases-title {
    width: 100%;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-style: normal;
    font-weight: 800;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -0.015em;
    color: #070D10;
    margin: 0;
    text-align: center;
  }

  .use-cases-subtitle {
    width: 100%;
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    color: #4A5C63;
    margin: 0;
    text-align: center;
  }

  /* Cards Grid */
  .use-cases-grid {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
    gap: 24px;
    box-sizing: border-box;
  }

  /* Individual Use Case Card */
  .use-case-card {
    flex: 1 1 0%;
    box-sizing: border-box;
    background-color: transparent;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  /* Card Image */
  .use-case-card__image-wrap {
    width: 100%;
    aspect-ratio: 310 / 380;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    background-color: #DCEBEC;
    box-shadow: 0 4px 16px rgba(7, 13, 16, 0.04);
  }

  .use-case-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 20px;
    transition: transform 0.35s ease;
  }

  .use-case-card:hover .use-case-card__image {
    transform: scale(1.03);
  }

  /* Card Copy */
  .use-case-card__copy {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .use-case-card__title {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-style: normal;
    font-weight: 700;
    font-size: 24px;
    line-height: 30px;
    letter-spacing: -0.005em;
    color: #070D10;
    margin: 0;
  }

  .use-case-card__body {
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #4A5C63;
    margin: 0;
  }

  /* Mobile Responsive Breakpoint (<= 860px) */
  @media screen and (max-width: 860px) {
    .use-cases-section {
      padding: 56px 0;
    }

    .use-cases-container {
      width: 90%;
      align-items: flex-start;
      gap: 32px;
    }

    .use-cases-heading {
      align-items: flex-start;
      text-align: left;
      gap: 10px;
    }

    .use-cases-title {
      font-size: 32px;
      line-height: 36px;
      letter-spacing: -0.01em;
      text-align: left;
    }

    .use-cases-subtitle {
      font-size: 18px;
      line-height: 28px;
      text-align: left;
    }

    .use-cases-grid {
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      align-items: flex-start;
      gap: 20px;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 16px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .use-cases-grid::-webkit-scrollbar {
      display: none;
    }

    .use-case-card {
      flex: 0 0 236px;
      scroll-snap-align: start;
    }

    .use-case-card__image-wrap {
      aspect-ratio: 236 / 280;
    }
  }
</style>

<section class="use-cases-section" id="UseCases-section">
  <div class="use-cases-container">
    
    <!-- Heading Block -->
    <div class="use-cases-heading">
      {% if section.settings.tag != blank %}
        <div class="use-cases-tag">
          {{ section.settings.tag }}
        </div>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="use-cases-title">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="use-cases-subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>

    <!-- Cards Grid -->
    <div class="use-cases-grid">
      
      <!-- Card 1: Sleep -->
      <div class="use-case-card">
        <div class="use-case-card__image-wrap">
          <img
            src="{{ 'magnific__edit-this-photo-change-only-the-color-of-the-white__55925.png' | asset_url }}"
            alt="{{ section.settings.card_1_title | default: 'Sleep' }}"
            class="use-case-card__image"
            loading="lazy"
          >
        </div>
        <div class="use-case-card__copy">
          <h3 class="use-case-card__title">
            {{ section.settings.card_1_title | default: 'Sleep' }}
          </h3>
          <p class="use-case-card__body">
            {{ section.settings.card_1_body | default: 'Breathe through your nose all night.' }}
          </p>
        </div>
      </div>

      <!-- Card 2: Workout -->
      <div class="use-case-card">
        <div class="use-case-card__image-wrap">
          <img
            src="{{ 'magnific__using-the-uploaded-reference-images-edit-image-1-b__55927.png' | asset_url }}"
            alt="{{ section.settings.card_2_title | default: 'Workout' }}"
            class="use-case-card__image"
            loading="lazy"
          >
        </div>
        <div class="use-case-card__copy">
          <h3 class="use-case-card__title">
            {{ section.settings.card_2_title | default: 'Workout' }}
          </h3>
          <p class="use-case-card__body">
            {{ section.settings.card_2_body | default: 'More air for runs, rides and lifts.' }}
          </p>
        </div>
      </div>

      <!-- Card 3: Congestion -->
      <div class="use-case-card">
        <div class="use-case-card__image-wrap">
          <img
            src="{{ 'magnific__using-the-uploaded-reference-images-recreate-the-c__55929.png' | asset_url }}"
            alt="{{ section.settings.card_3_title | default: 'Congestion' }}"
            class="use-case-card__image"
            loading="lazy"
          >
        </div>
        <div class="use-case-card__copy">
          <h3 class="use-case-card__title">
            {{ section.settings.card_3_title | default: 'Congestion' }}
          </h3>
          <p class="use-case-card__body">
            {{ section.settings.card_3_body | default: 'Open up when allergies or colds hit.' }}
          </p>
        </div>
      </div>

      <!-- Card 4: All day -->
      <div class="use-case-card">
        <div class="use-case-card__image-wrap">
          <img
            src="{{ 'magnific__upscale-this-image-to-high-resolution-4x-and-enhan__55928.png' | asset_url }}"
            alt="{{ section.settings.card_4_title | default: 'All day' }}"
            class="use-case-card__image"
            loading="lazy"
          >
        </div>
        <div class="use-case-card__copy">
          <h3 class="use-case-card__title">
            {{ section.settings.card_4_title | default: 'All day' }}
          </h3>
          <p class="use-case-card__body">
            {{ section.settings.card_4_body | default: 'Low-profile enough for work and travel.' }}
          </p>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
