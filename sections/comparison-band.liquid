{% comment %}
  UnlockedAir - "Comparison Band" Section
  Features:
  - Responsive percentage-based layout (no fixed widths)
  - Embedded CSS with clean direct class selectors (no section.id in CSS)
  - No clamp() and no mixed heights
  - Deep Teal (#0B3C44) featured card with pop-out UnlockedAir band
  - Clean alternatives cards with Aqua checks and Red dashes
  - Horizontally swipeable layout on mobile devices
  - Fully customizable Shopify Theme Customizer Schema
{% endcomment %}

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .comparison-band-section {
    width: 100%;
    box-sizing: border-box;
    position: relative;
    background-color: #F4F7F7;
    padding: 96px 0;
  }

  .comparison-band-container {
    width: 90%;
    max-width: 1312px;
    margin: 0 auto;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  /* Heading Block */
  .comparison-band-heading {
    width: 100%;
    max-width: 900px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .comparison-band-title {
    width: 100%;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-style: normal;
    font-weight: 800;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -0.015em;
    color: #070D10;
    margin: 0;
    text-align: center;
  }

  .comparison-band-subtitle {
    width: 100%;
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    color: #4A5C63;
    margin: 0;
    text-align: center;
  }

  /* Cards Grid / Container */
  .comparison-cards-grid {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    gap: 24px;
    box-sizing: border-box;
    padding-top: 36px; /* Room for pop-out band on featured card */
  }

  /* Individual Card */
  .comparison-card {
    flex: 1 1 0%;
    box-sizing: border-box;
    border-radius: 12px;
    padding: 24px 20px 32px 20px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 36px;
    position: relative;
    box-shadow: 0 4px 20px rgba(7, 13, 16, 0.04);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .comparison-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(7, 13, 16, 0.08);
  }

  /* Featured Brand Card (UnlockedAir) */
  .comparison-card--featured {
    background-color: #0B3C44;
    color: #F4F7F7;
    overflow: visible;
  }

  /* Alternative Cards */
  .comparison-card--standard {
    background-color: #FFFFFF;
    color: #070D10;
  }

  /* Card Header */
  .comparison-card__header {
    width: 100%;
    height: 102px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    box-sizing: border-box;
  }

  /* Pop-out Dilator Image for Featured Card */
  .comparison-card__popout-image {
    position: absolute;
    top: -52px;
    left: 50%;
    transform: translateX(-50%);
    width: 74px;
    height: 130px;
    object-fit: contain;
    pointer-events: none;
    z-index: 2;
  }

  /* Alternative Product Images */
  .comparison-card__product-image {
    height: 76px;
    width: auto;
    max-width: 80px;
    object-fit: contain;
    margin-bottom: 6px;
    display: block;
  }

  .comparison-card__product-image--strips {
    max-width: 53px;
    opacity: 0.85;
  }

  .comparison-card__product-image--spray {
    max-width: 77px;
  }

  .comparison-card__product-image--device {
    max-width: 50px;
  }

  /* Card Brand Title */
  .comparison-card__title {
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    margin: 0;
    text-align: center;
    white-space: nowrap;
  }

  .comparison-card--featured .comparison-card__title {
    color: #F4F7F7;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .comparison-card--standard .comparison-card__title {
    color: #070D10;
  }

  /* Features List */
  .comparison-card__features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Feature Item */
  .comparison-feature-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 13px;
    width: 100%;
    height: 48px;
    box-sizing: border-box;
  }

  /* Badge Icon */
  .comparison-icon {
    width: 24px;
    height: 24px;
    min-width: 24px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .comparison-icon--check {
    background-color: #2EE6D6;
  }

  .comparison-icon--dash {
    background-color: #F64242;
  }

  /* Feature Text */
  .comparison-feature-text {
    font-family: 'Poppins', sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 15px;
    line-height: 22px;
    margin: 0;
    flex: 1 1 0%;
  }

  .comparison-card--featured .comparison-feature-text {
    color: #F4F7F7;
  }

  .comparison-card--standard .comparison-feature-text {
    color: #070D10;
  }

  /* Mobile Breakpoint (<= 860px) */
  @media screen and (max-width: 860px) {
    .comparison-band-section {
      padding: 56px 0;
    }

    .comparison-band-container {
      width: 90%;
      gap: 36px;
    }

    .comparison-band-heading {
      gap: 12px;
    }

    .comparison-band-title {
      font-size: 32px;
      line-height: 36px;
      letter-spacing: -0.01em;
    }

    .comparison-band-subtitle {
      font-size: 16px;
      line-height: 26px;
    }

    .comparison-cards-grid {
      display: flex;
      flex-direction: row;
      justify-content: flex-start;
      align-items: stretch;
      gap: 12px;
      width: 100%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 38px 4px 16px 4px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .comparison-cards-grid::-webkit-scrollbar {
      display: none;
    }

    .comparison-card {
      flex: 0 0 230px;
      scroll-snap-align: start;
      padding: 20px 14px 28px 14px;
      gap: 32px;
    }

    .comparison-feature-row {
      gap: 10px;
    }

    .comparison-feature-text {
      font-size: 14px;
      line-height: 20px;
    }
  }
</style>

