{% schema %}
{
  "name": "Comparison Band",
  "tag": "section",
  "class": "section-comparison-band",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading Title",
      "default": "UnlockedAir vs the alternatives"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle Description",
      "default": "How a magnetic dilator compares with strips and sprays."
    },
    {
      "type": "header",
      "content": "Card 1: Featured Brand"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Card 1 Title",
      "default": "UNLOCKED AIR"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Card 1 Dilator Image"
    },
    {
      "type": "header",
      "content": "Card 2: Nasal Strips"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Card 2 Title",
      "default": "Nasal strips"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Card 2 Image"
    },
    {
      "type": "header",
      "content": "Card 3: Nasal Spray"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "label": "Card 3 Title",
      "default": "Nasal Spray"
    },
    {
      "type": "image_picker",
      "id": "card_3_image",
      "label": "Card 3 Image"
    },
    {
      "type": "header",
      "content": "Card 4: Other Devices"
    },
    {
      "type": "text",
      "id": "card_4_title",
      "label": "Card 4 Title",
      "default": "Other Devices"
    },
    {
      "type": "image_picker",
      "id": "card_4_image",
      "label": "Card 4 Image"
    }
  ],
  "presets": [
    {
      "name": "Comparison Band"
    }
  ]
}
{% endschema %}
